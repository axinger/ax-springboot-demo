<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.axinger</groupId>
        <artifactId>b43-modulith</artifactId>
        <version>2026.01.01-3.5</version>
    </parent>

    <artifactId>b43-modulith-app</artifactId>
    <packaging>jar</packaging>

    <name>b43-modulith-app</name>
    <description>Spring Modulith 企业级模块化架构应用主程序</description>

    <dependencies>
        <!-- 引入所有业务模块 -->
        <dependency>
            <groupId>com.github.axinger</groupId>
            <artifactId>order-module</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.axinger</groupId>
            <artifactId>customer-module</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.axinger</groupId>
            <artifactId>inventory-module</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.axinger</groupId>
            <artifactId>payment-module</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.axinger</groupId>
            <artifactId>notification-module</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.axinger</groupId>
            <artifactId>shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot 启动器 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- API 文档 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.1.0</version>
        </dependency>

        <!-- Spring Modulith Actuator 支持（生产环境必需） -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-actuator</artifactId>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.axinger.modulith.ModulithApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>