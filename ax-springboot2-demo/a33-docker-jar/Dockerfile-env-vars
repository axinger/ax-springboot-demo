# ===========================================================================
# 方案三：环境变量优先方案（12-Factor App推荐）
# 特点：所有配置通过环境变量注入，符合云原生最佳实践
# ===========================================================================

FROM eclipse-temurin:21-jdk-jammy

LABEL maintainer="阿星" \
      version="2.0.0" \
      description="Spring Boot应用生产镜像-环境变量方案" \
      org.opencontainers.image.source="https://github.com/axinger/ax-springboot-demo"

# 创建非特权用户
RUN groupadd -r appuser && useradd -r -g appuser appuser

# 设置时区
RUN /bin/cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && echo 'Asia/Shanghai' >/etc/timezone

# 环境变量配置（默认值，会被运行时环境变量覆盖）
ENV APP_HOME=/app \
    APP_NAME=server.jar \
    JAVA_OPTS="-Xms512m -Xmx1024m -Xmn256m -XX:+UseG1GC -XX:+HeapDumpOnOutOfMemoryError" \
    SPRING_PROFILES_ACTIVE=prd \
    SERVER_PORT=13301 \
    SERVER_CONTEXT_PATH=/axinger \
    LOG_LEVEL_ROOT=WARN \
    LOG_LEVEL_APP=INFO \
    LOG_FILE=/var/log/a33-docker-jar/application.log

WORKDIR ${APP_HOME}

# 创建目录
RUN mkdir -p /var/log/a33-docker-jar && \
    chown -R appuser:appuser /var/log/a33-docker-jar

# 只复制JAR包，所有配置通过环境变量注入
COPY target/*.jar ./${APP_NAME}

USER appuser

# 健康检查（使用环境变量中的端口）
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:${SERVER_PORT}/axinger/actuator/health || exit 1

EXPOSE ${SERVER_PORT}

# 启动命令：完全依赖环境变量配置
ENTRYPOINT exec java ${JAVA_OPTS} -jar ./${APP_NAME} \
    --spring.profiles.active=${SPRING_PROFILES_ACTIVE}