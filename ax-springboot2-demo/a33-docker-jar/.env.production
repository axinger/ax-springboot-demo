# ===========================================================================
# 生产环境敏感配置（环境变量文件）
# 注意：此文件包含敏感信息，不应提交到版本控制
# 使用：docker-compose会自动加载此文件中的环境变量
# ===========================================================================

# 数据库配置
DATABASE_URL=jdbc:mysql://mysql-server:3306/production_db?useSSL=false&serverTimezone=Asia/Shanghai
DATABASE_USERNAME=prod_user
DATABASE_PASSWORD=your_secure_password_here

# Redis配置
REDIS_HOST=redis-server
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# 第三方API密钥
API_KEY_THIRD_PARTY=your_api_key
PAYMENT_GATEWAY_KEY=your_payment_key

# 邮件配置
MAIL_HOST=smtp.company.com
MAIL_PORT=587
MAIL_USERNAME=notification@company.com
MAIL_PASSWORD=your_mail_password

# 监控配置
PROMETHEUS_ENABLED=true
GRAFANA_URL=http://grafana:3000

# 日志级别（生产环境）
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=WARN

# 应用性能配置
MAX_THREADS=200
CONNECTION_POOL_SIZE=20
CACHE_TTL=1800