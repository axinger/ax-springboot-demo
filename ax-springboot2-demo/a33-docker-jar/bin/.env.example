# ============================================================================
# 应用配置文件 (.env)
# 说明: 
#   1. 此文件会被 bin/start.sh 自动加载
#   2. 配置优先级: 命令行参数 > .env 文件 > 脚本内默认值
#   3. 修改后无需重启，下次启动时生效
# ============================================================================

# ------------------- 基础配置 -------------------
# 应用部署路径
APP_PATH="/opt/application/demo-app"

# 应用名称 (用于进程识别和日志文件命名)
APP_NAME="demo-application"

# 日志存储路径
LOG_PATH="/opt/logs/demo"

# 运行模式: cluster (集群) 或 standalone (单机)
MODE="cluster"

# Java 版本: 留空则自动检测，或指定 8, 11, 17, 21
JAVA_VERSION=""

# ------------------- Nacos 配置中心 -------------------
# Nacos 配置中心服务器地址
SPRING_CLOUD_NACOS_CONFIG_SERVER_ADDR="localhost:8848"

# Nacos 服务发现服务器地址 (通常与配置中心相同)
SPRING_CLOUD_NACOS_DISCOVERY_SERVER_ADDR="localhost:8848"

# ------------------- Spring Boot 配置 -------------------
# Spring 配置文件搜索路径
SPRING_CONFIG_LOCATION="classpath:/,classpath:/config/,file:./,file:./config/"

# HTTP 请求头大小限制 (字节)，默认 512KB
SERVER_MAX_HTTP_HEADER_SIZE="524288"

# ------------------- 其他自定义 JVM 参数 -------------------
# 额外的 JVM 参数 (可选)
# JAVA_OPT_EXT="-Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8"
