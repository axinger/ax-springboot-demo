<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback 主配置文件
    职责：引入其他配置文件模块

    文件结构：
    - logback-base.xml     : 基础配置（属性定义、控制台、通用日志）
    - logback-business.xml : 业务日志配置（订单、支付等业务独立日志）
-->
<configuration scan="true" scanPeriod="60 seconds" debug="false">

    <!-- 引入基础配置：属性定义 + 通用日志（控制台、DEBUG/INFO/WARN/ERROR/ALL） -->
    <include resource="logback-base.xml"/>

    <!-- 引入业务日志配置：订单、支付等业务独立日志 -->
    <include resource="logback-business.xml"/>

</configuration>
