<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.github.axinger.sys.mapper.EmployeeMapper">

    <resultMap id="BaseResultMap" type="com.github.axinger.sys.domain.EmployeeEntity">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="email" column="email"/>
        <result property="gender" column="gender"/>
        <result property="deptId" column="dept_id"/>
    </resultMap>

    <resultMap id="BaseResultMapOfDepartment" type="com.github.axinger.sys.domain.EmployeeEntity"
               extends="BaseResultMap">
        <collection property="departmentEntity" ofType="com.github.axinger.sys.domain.DepartmentEntity">
            <!--            含有相同的字段名-->
            <id property="id" column="d_id"/>
            <result property="name" column="d_name"/>
        </collection>
    </resultMap>

    <sql id="Base_Column_List">
        id
        ,name,email,
        gender,dept_id
    </sql>

    <select id="leftDepartment" resultMap="BaseResultMapOfDepartment">
        SELECT *
        FROM (SELECT d.id   as d_id,
                     d.name as d_name,
                     e.*
              FROM sys_department d
                       left JOIN sys_employee e ON e.dept_id = d.id) AS t
            ${ew.customSqlSegment}
    </select>
</mapper>
