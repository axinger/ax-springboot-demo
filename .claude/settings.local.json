{
  "permissions": {
    "allow": [
      "Bash(mvn clean *)",
      "Bash(where mvn *)",
      "Bash(mkdir -p axinger-bom)",
      "Bash(mv axinger-common-bom *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"%CLAUDE_PROJECT_DIR%/.claude/hooks/post-tool-call.py\""
          }
        ]
      }
    ]
  }
}