{
  "permissions": {
    "allow": [
      "Bash(mvn clean *)",
      "Bash(where mvn *)",
      "Bash(mkdir -p axinger-bom)",
      "Bash(mv axinger-common-bom *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"%CLAUDE_PROJECT_DIR%/.claude/hooks/post-tool-call.py\""
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "本地数据库-demo1": {
      "command": "npx",
      "args": [
        "-y",
        "@benborla29/mcp-server-mysql"
      ],
      "env": {
        "MYSQL_HOST": "localhost",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASS": "root",
        "MYSQL_DB": "demo1",
        "MYSQL_SSL": "false"
      },
      "type": "stdio"
    }
  }
}
