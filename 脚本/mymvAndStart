#!/bin/bash

# 目标目录的基础路径
base_dir="/opt/applications"

# 检查是否提供了 JAR 文件
if [ $# -eq 0 ]; then
    echo "用法: $0 <jar文件> [<jar文件> ...]"
    exit 1
fi

# 根据 JAR 文件名（不含路径）查找并 kill 对应的 Java 进程
kill_by_jar_name() {
    local jar_basename="$1"  # 如 myapp.jar

    # 使用 ps 查找包含该 JAR 的 java 进程（排除 grep 自身）
    # 注意：必须匹配完整路径或文件名，避免部分匹配
    pids=$(ps aux | grep "java" | grep -v grep | grep "$jar_basename" | awk '{print $2}')

    if [ -n "$pids" ]; then
        for pid in $pids; do
            echo "找到进程 PID=$pid (包含 JAR: $jar_basename)"
            kill "$pid" 2>/dev/null
        done
        sleep 2

        # 检查是否还有残留进程
        remaining_pids=$(echo "$pids" | xargs -I {} sh -c 'if kill -0 {} 2>/dev/null; then echo {}; fi')
        if [ -n "$remaining_pids" ]; then
            echo "警告: 以下进程未退出，强制终止: $remaining_pids"
            echo "$remaining_pids" | xargs kill -9 2>/dev/null
        fi
        echo "✅ 已停止所有与 $jar_basename 相关的进程。"
    else
        echo "ℹ️  $jar_basename 当前未运行。"
    fi
}

# 遍历所有提供的 JAR 文件
for file in "$@"; do
    # 检查文件是否存在且是 .jar 文件
    if [ ! -f "$file" ]; then
        echo "❌ 错误: 文件 $file 不存在。"
        continue
    fi
    if [[ "$file" != *.jar ]]; then
        echo "❌ 错误: $file 不是 .jar 文件。"
        continue
    fi

    # 获取基础文件名和应用名
    jar_basename=$(basename "$file")
    app_name="${jar_basename%.jar}"

    # 创建目标目录
    target_dir="${base_dir}/${app_name}"
    mkdir -p "$target_dir"

    echo "📁 基础目录: $base_dir"
    echo "🎯 目标目录: $target_dir"
    echo "📛 应用名称: $app_name"

    # 备份旧 JAR（如果存在）
    if [ -f "$target_dir/$jar_basename" ]; then
        timestamp=$(date +%Y%m%d%H%M%S)
        mv "$target_dir/$jar_basename" "$target_dir/${app_name}_${timestamp}.jar"
        echo "📦 已备份旧 JAR 为 ${app_name}_${timestamp}.jar"
    fi

    # 移动新 JAR
    mv "$file" "$target_dir/"
    echo "📤 已移动 $file 到 $target_dir/"

    # 定义日志路径
    log_file="$target_dir/${app_name}.log"
    jar_file="$target_dir/$jar_basename"

    # 停止旧进程（通过 JAR 文件名）
    kill_by_jar_name "$jar_basename"

    # 启动新进程
    echo "🚀 正在启动 $app_name..."
    nohup java -Xms1024m -Xmx1024m -Xmn512m -jar "$jar_file" > "$log_file" 2>&1 &
    echo "✅ $app_name 启动成功！日志: $log_file"
done