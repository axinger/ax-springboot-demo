 #!/bin/bash

# ========== 配置 ==========
services=(
    "mydemo1"
    # 可在此添加更多服务，如 "order-service", "user-api" 等
)

base_dir="/opt/applications"

# ========== 函数定义 ==========

# 显示服务列表供选择
show_service_menu() {
    echo "请选择要操作的服务："
    echo "0) 全部服务"
    for i in "${!services[@]}"; do
        echo "$((i+1))) ${services[i]}"
    done
}

# 显示操作菜单
show_operation_menu() {
    echo
    echo "请选择操作："
    echo "1) start"
    echo "2) stop"
    echo "3) restart"
}

# 根据 JAR 文件名检查是否正在运行（返回 PID 列表）
get_pids_by_jar() {
    local jar_name="$1"  # 如 kds-ikitchen-1.0-SNAPSHOT.jar
    # 使用 ps + grep 查找包含该 JAR 的 java 进程，排除 grep 自身
    ps aux | grep "java" | grep -v grep | grep "$jar_name" | awk '{print $2}'
}

# 停止指定 JAR 的所有进程
stop_service_by_jar() {
    local jar_name="$1"
    local pids
    pids=$(get_pids_by_jar "$jar_name")

    if [ -n "$pids" ]; then
        echo "🛑 正在停止 $jar_name (PID: $pids)..."
        kill $pids 2>/dev/null
        sleep 2

        # 检查是否还有残留
        remaining=$(echo "$pids" | xargs -I {} sh -c 'if kill -0 {} 2>/dev/null; then echo {}; fi')
        if [ -n "$remaining" ]; then
            echo "⚠️  强制终止未退出的进程: $remaining"
            kill -9 $remaining 2>/dev/null
        fi
        echo "✅ $jar_name 已停止。"
    else
        echo "ℹ️  $jar_name 当前未运行。"
    fi
}

# 启动服务
start_service() {
    local service_name="$1"
    local jar_file="$base_dir/$service_name/$service_name.jar"
    local log_file="$base_dir/$service_name/$service_name.log"

    if [ ! -f "$jar_file" ]; then
        echo "❌ JAR 文件不存在: $jar_file"
        return 1
    fi

    # 检查是否已在运行
    local running_pids
    running_pids=$(get_pids_by_jar "$service_name.jar")
    if [ -n "$running_pids" ]; then
        echo "⚠️  $service_name 已在运行中 (PID: $running_pids)，无需重复启动。"
        return 0
    fi

    echo "🚀 正在启动 $service_name..."
    mkdir -p "$(dirname "$log_file")"
    nohup java -Xms1024m -Xmx1024m -Xmn512m -jar "$jar_file" > "$log_file" 2>&1 &
    echo "✅ $service_name 启动成功！日志: $log_file"
}

# ========== 主流程 ==========

# 显示服务菜单并读取选择
show_service_menu
read -p "请输入服务编号: " svc_input

# 校验输入
if ! [[ "$svc_input" =~ ^[0-9]+$ ]]; then
    echo "❌ 错误：请输入有效数字！"
    exit 1
fi

if [ "$svc_input" -lt 0 ] || [ "$svc_input" -gt "${#services[@]}" ]; then
    echo "❌ 错误：编号超出范围！"
    exit 1
fi

# 确定选中的服务
if [ "$svc_input" -eq 0 ]; then
    selected=("${services[@]}")
else
    selected=("${services[$((svc_input-1))]}")
fi

# 显示操作菜单
show_operation_menu
read -p "请选择操作编号 (1-3): " op_input

case "$op_input" in
    1) operation="start" ;;
    2) operation="stop" ;;
    3) operation="restart" ;;
    *)
        echo "❌ 无效操作，请输入 1、2 或 3。"
        exit 1
        ;;
esac

# 执行操作
for svc in "${selected[@]}"; do
    jar_name="$svc.jar"
    echo
    echo "──────────────────────────────"
    echo "🔧 服务: $svc"

    case "$operation" in
        start)
            start_service "$svc"
            ;;
        stop)
            stop_service_by_jar "$jar_name"
            ;;
        restart)
            stop_service_by_jar "$jar_name"
            sleep 1
            start_service "$svc"
            ;;
    esac
done

echo
echo "🎉 操作完成！"
